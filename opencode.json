{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "serena": {
      "type": "local",
      "command": [
        "direnv",
        "exec",
        ".",
        "uvx",
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--project-from-cwd",
        "--context=agent",
        "--open-web-dashboard",
        "false"
      ],
      "enabled": true,
      "environment": {
        "SERENA_HOME": ".serena/runtime",
        "NPM_CONFIG_CACHE": ".serena/runtime/npm-cache",
        "UV_CACHE_DIR": ".uv-cache",
        "UV_TOOL_DIR": ".uv-tools",
        "UV_PYTHON_INSTALL_DIR": ".uv-python"
      }
    }
  }
}
